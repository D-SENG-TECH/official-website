---
page_key: profile
page_path: profile/
---
{%- set t = i18n[lang.code] -%}
{%- set p = t.profile -%}
{%- set aff = t.about.affiliates[0] -%}
{%- set local_fmt = (lang.code == "zh-tw") -%}
{%- macro org_node(node) -%}
<li>
  <div class="node{% if node.k %} node--{{ node.k | replace('_', '-') }}{% endif %}"><b>{{ node.t }}</b>{% if node.s %}<small>{{ node.s }}</small>{% endif %}{% if node.n %}<span>{{ node.n }}</span>{% endif %}</div>
  {%- if node.c %}
  <ul>
    {%- for child in node.c %}{{ org_node(child) }}{% endfor %}
  </ul>
  {%- endif %}
</li>
{%- endmacro -%}
<link rel="stylesheet" href="/assets/profile.css">

<div class="profile">
  <header class="pf-cover">
    <div class="pf-cover__inner">
      <img class="pf-cover__logo pf-cover__logo--screen" src="/assets/logo-dark.svg" width="2246" height="512" alt="{{ t.common.company_name }}">
      <img class="pf-cover__logo pf-cover__logo--print" src="/assets/logo.svg" width="2246" height="512" alt="">
      <div class="pf-cover__main">
        <p class="pf-eyebrow">{{ p.cover_eyebrow }}</p>
        <h1 class="pf-cover__title"><span>{{ t.home.headline_a | replace("・", "") }}</span><span class="pf-gold">{{ t.home.headline_b }}</span></h1>
        <p class="pf-cover__desc">{{ t.meta.og_description }}</p>
      </div>
      <div class="pf-cover__foot">
        <div class="pf-cover__names">
          <strong>{{ t.common.company_name }}</strong>
          <span>{{ t.common.company_name_en }}</span>
        </div>
        <figure class="pf-qr"><img src="/assets/qr-d-seng.svg" width="290" height="290" alt="QR code: {{ site.url }}"><figcaption>{{ site.url | replace("https://", "") }}</figcaption></figure>
      </div>
    </div>
  </header>

  <section class="pf-printtoc" aria-hidden="true">
    <p class="pf-kicker">{{ p.cover_eyebrow }}</p>
    <h2>{{ p.contents }}</h2>
    {%- set pg = (profile_toc[lang.code] if profile_toc else {}) or {} %}
    <ol class="pf-printtoc__list">
      {%- for key in ["about", "values", "org", "business", "affiliate", "contact"] %}
      <li>
        <a href="#pf-{{ key }}"><b>{{ "0" + loop.index }}</b><span>{{ t.about.org_title if key == "org" else p.sections[key] }}</span><i>{{ pg["pf-" + key] }}</i></a>
        {%- if key == "business" %}
        <ol>
          {%- for item in t.business.items %}
          {%- set bid = "pf-biz-" + (item.id | replace("_", "-")) %}
          <li><a href="#{{ bid }}"><b>{{ "0" + loop.index }}</b><span>{{ item.title }}</span><i>{{ pg[bid] }}</i></a></li>
          {%- endfor %}
        </ol>
        {%- endif %}
      </li>
      {%- endfor %}
    </ol>
  </section>

  <nav class="pf-toc" aria-label="{{ p.contents }}">
    <div class="wrap pf-toc__inner">
      <span class="pf-toc__label">{{ p.contents }}</span>
      <ol>
        {%- for key in ["about", "values", "org", "business", "affiliate", "contact"] %}
        <li><a href="#pf-{{ key }}"><b>{{ loop.index }}</b>{{ t.about.org_title if key == "org" else p.sections[key] }}</a></li>
        {%- endfor %}
      </ol>
      <button type="button" class="pf-toc__print" onclick="window.print()" title="{{ p.print_hint }}" aria-label="{{ p.print }}">
        <svg class="pf-toc__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6"/><rect x="6" y="14" width="12" height="7" rx="1"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/></svg>
        <span class="pf-toc__print-long">{{ p.print }}</span><span class="pf-toc__print-short" aria-hidden="true">PDF</span>
      </button>
    </div>
  </nav>
  <script>
  (() => {
    /* Keep the ToC bar (with the print button) under the sticky site header */
    const root = document.currentScript.closest(".profile");
    const header = document.querySelector(".site-header");
    const setTop = () => root.style.setProperty("--pf-top",
      (header && getComputedStyle(header).position === "sticky" ? header.offsetHeight : 0) + "px");
    setTop();
    addEventListener("resize", setTop);

    /* Highlight the section in view and keep its link visible in the (scrollable) list */
    const list = root.querySelector(".pf-toc ol");
    const links = [...list.querySelectorAll("a")];
    const byId = new Map(links.map((a) => [a.getAttribute("href").slice(1), a]));
    if (!("IntersectionObserver" in window)) return;
    let current;
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) {
        const a = byId.get(e.target.id);
        if (!a || a === current) continue;
        current?.removeAttribute("aria-current");
        a.setAttribute("aria-current", "true");
        current = a;
        const left = a.offsetLeft - list.offsetLeft - 16;
        list.scrollTo({ left, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      }
    }, { rootMargin: "-45% 0px -50% 0px" });
    // the sections come after this script in the document
    const watch = () => { for (const id of byId.keys()) { const el = document.getElementById(id); if (el) io.observe(el); } };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", watch); else watch();
  })();
  </script>

  <section class="pf-section pf-about" id="pf-about">
    <div class="wrap pf-about__grid">
      <div class="pf-about__text">
        <p class="pf-kicker">01</p>
        <h2>{{ p.sections.about }}</h2>
        <p class="pf-lead">{{ t.home.intro }}</p>
        {%- set ch = t.about.story[0] %}
        <div class="pf-story">
          <p class="pf-story__year">{{ ch.year or "2026" }}</p>
          <h3>{{ ch.title }}</h3>
          <p>{{ ch.text }}</p>
        </div>
      </div>
      <figure class="pf-photo">
        <img src="/assets/office.jpg" width="896" height="1200" alt="{{ t.about.office_alt }}">
      </figure>
    </div>
  </section>

  <section class="pf-section pf-values" id="pf-values">
    <div class="wrap">
      <p class="pf-kicker">02</p>
      <h2>{{ p.sections.values }}</h2>
      <ul class="pf-values__list">
        {%- for v in t.home.values %}
        <li><span class="pf-values__no">{{ loop.index }}</span><h3>{{ v.title }}</h3><p>{{ v.text }}</p></li>
        {%- endfor %}
      </ul>
    </div>
  </section>

  <section class="pf-section pf-org" id="pf-org">
    <div class="wrap">
      <p class="pf-kicker">03</p>
      <h2>{{ t.about.org_title }}</h2>
    </div>
    <div class="wrap wrap--wide">
      <div class="tree pf-tree">
        <ul>{{ org_node(t.about.org) }}</ul>
      </div>
    </div>
  </section>

  <section class="pf-section pf-business" id="pf-business">
    <div class="wrap">
      <p class="pf-kicker">04</p>
      <h2>{{ p.sections.business }}</h2>
      <p class="pf-lead">{{ p.business_lead }}</p>
      <ol class="pf-index">
        {%- for item in t.business.items %}
        <li><a href="#pf-biz-{{ item.id | replace('_','-') }}"><b>{{ "0" + loop.index }}</b>{{ item.title }}</a></li>
        {%- endfor %}
      </ol>
    </div>
    {%- for item in t.business.items %}
    {%- set slug = item.id | replace('_','-') %}
    <article class="pf-biz" id="pf-biz-{{ slug }}">
      <div class="wrap">
        <header class="pf-biz__head">
          <span class="pf-biz__no">{{ "0" + loop.index }}</span>
          <h3><a href="{{ lang.prefix }}business/{{ slug }}/">{{ item.title }}</a></h3>
          <p class="pf-biz__summary">{{ item.summary }}</p>
        </header>
        {%- set is_ai = item.id == "ai_monitoring" %}
        <div class="pf-biz__main{% if not item.image and not item.gallery.length and not is_ai %} pf-biz__main--text{% endif %}">
          <div class="pf-biz__text">
            {%- for para in item.body %}<p>{{ para }}</p>{% endfor %}
            {%- if item.points.length %}
            <ul class="pf-points">
              {%- for pt in item.points %}<li>{{ pt }}</li>{% endfor %}
            </ul>
            {%- endif %}
            {%- if item.brands.length %}
            <p class="pf-brands"><span>{{ t.business.brands_label }}</span>{{ item.brands | join("・") }}</p>
            {%- endif %}
          </div>
          {%- if is_ai %}
          <div class="pf-biz__media">
            <img class="pf-biz__img" src="/assets/aimon/hero-bg-poster.jpg" alt="{{ aimon.answer[lang.code].img_alt }}">
          </div>
          {%- elif item.image or item.gallery.length %}
          <div class="pf-biz__media">
            {%- if item.image %}
            <img class="pf-biz__img" src="/assets/business/{{ item.image }}" alt="{{ item.image_alt }}">
            {%- endif %}
            {%- if item.gallery.length %}
            <ul class="pf-biz__thumbs">
              {%- for g in item.gallery %}{% if loop.index0 < 3 %}
              <li><img src="/assets/{{ g.src }}.jpg" alt="{{ g.caption }}"></li>
              {%- endif %}{% endfor %}
            </ul>
            {%- endif %}
          </div>
          {%- endif %}
        </div>
        {%- if is_ai %}{% include "profile-aimon.njk" %}{% endif %}
        {%- if item.sections.length %}
        <div class="pf-biz__secs">
          {%- for sec in item.sections %}
          <div class="pf-biz__sec">
            <h4>{{ sec.title }}</h4>
            {%- if sec.text %}<p>{{ sec.text }}</p>{% endif %}
            {%- if sec.list.length %}
            <ul class="pf-points">
              {%- for li in sec.list %}<li>{{ li }}</li>{% endfor %}
            </ul>
            {%- endif %}
          </div>
          {%- endfor %}
        </div>
        {%- endif %}
      </div>
    </article>
    {%- endfor %}
  </section>

  <section class="pf-section pf-affiliate" id="pf-affiliate">
    <div class="wrap">
      <p class="pf-kicker">05</p>
      <h2>{{ p.sections.affiliate }}</h2>
      <h3 class="pf-aff__name">{{ aff.name_full }}</h3>
      <p class="pf-lead">{{ aff.text }}</p>
      <dl class="pf-facts">
        {%- for f in aff.facts %}
        <div><dt>{{ f.label }}</dt><dd>{{ f.value }}</dd></div>
        {%- endfor %}
      </dl>
      <h3 class="pf-sub">{{ p.affiliate_products }}</h3>
      <ul class="pf-gs">
        {%- for g in t.gold_stone.groups %}
        <li>
          <img src="/assets/gold-stone/{{ gs_media[loop.index0].cover }}" alt="">
          <div><strong>{{ g.title }}</strong><span>{{ g.brands | join(" · ") }}</span></div>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </section>

  <section class="pf-section pf-contact" id="pf-contact">
    <div class="wrap pf-contact__grid">
      <div>
        <p class="pf-kicker">06</p>
        <h2>{{ p.sections.contact }}</h2>
        <p class="pf-lead">{{ p.contact_lead }}</p>
        <dl class="pf-contact__list">
          <div><dt>{{ t.common.address_label }}</dt><dd>{{ t.common.address }}</dd></div>
          <div><dt>{{ t.common.phone_label }}</dt><dd><a href="tel:{{ site.phone_tel }}">{% if local_fmt %}{{ site.phone }}{% else %}{{ site.phone_intl }}{% endif %}</a></dd></div>
          <div><dt>{{ t.common.fax_label }}</dt><dd>{% if local_fmt %}{{ site.fax }}{% else %}{{ site.fax_intl }}{% endif %}</dd></div>
          <div><dt>{{ t.common.email_label }}</dt><dd><a href="mailto:{{ site.email_info }}">{{ site.email_info }}</a></dd></div>
        </dl>
      </div>
      <div class="pf-contact__logo">
        <img src="/assets/logo-vertical.svg" width="954" height="1271" alt="{{ t.common.company_name }}">
        <figure class="pf-qr"><img src="/assets/qr-d-seng.svg" width="290" height="290" alt="QR code: {{ site.url }}"><figcaption>{{ site.url | replace("https://", "") }}</figcaption></figure>
      </div>
    </div>
    <div class="wrap">
      <p class="pf-webnote">{{ p.web_note }} <a href="{{ lang.prefix }}profile/">{{ site.url }}{{ lang.prefix }}profile/</a></p>
    </div>
  </section>
</div>
