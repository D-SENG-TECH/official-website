---
page_key: home
page_path: ""
---
{%- set t = i18n[lang.code] -%}
{% include "hero3d.njk" %}

<section class="section">
  <div class="wrap">
    <h2>{{ t.home.intro_title }}</h2>
    <p class="lead">{{ t.home.intro }}</p>
    <ul class="values">
      {%- for v in t.home.values %}
      <li><h3>{{ v.title }}</h3><p>{{ v.text }}</p></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <h2>{{ t.home.business_title }}</h2>
    <div class="cards">
      {%- for item in t.business.items %}
      <a class="card card--link" href="{{ lang.prefix }}business/{{ item.id | replace('_', '-') }}/">
        <h3>{{ item.title }}</h3>
        <p>{{ item.summary }}</p>
      </a>
      {%- endfor %}
    </div>
    <p class="more"><a href="{{ lang.prefix }}business/">{{ t.home.business_more }} →</a></p>
  </div>
</section>

<section class="section">
  <div class="wrap split">
    <div>
      <h2>{{ t.home.story_title }}</h2>
      {%- for para in t.home.story_teaser.split("\n\n") %}
      <p class="lead">{{ para }}</p>
      {%- endfor %}
      <p class="more"><a href="{{ lang.prefix }}about/">{{ t.home.story_more }} →</a></p>
    </div>
    <figure class="home-story__photo">
      <img src="/assets/office.jpg" width="896" height="1200" alt="{{ t.about.office_alt }}" loading="lazy">
      <figcaption>{{ t.about.office_caption }}</figcaption>
    </figure>
  </div>
</section>

<section class="section section--dark">
  <div class="wrap cta-band">
    <div>
      <h2>{{ t.home.contact_title }}</h2>
      <p>{{ t.home.contact_text }}</p>
    </div>
    <a class="button" href="{{ lang.prefix }}contact/">{{ t.common.contact_us }}</a>
  </div>
</section>
