---
page_key: careers
page_path: careers/
---
{%- set t = i18n[lang.code] -%}
{% include "page-head.njk" %}

<section class="section">
  <div class="wrap">
    <h2>{{ t.careers.why_title }}</h2>
    <ul class="values">
      {%- for w in t.careers.why %}
      <li><h3>{{ w.title }}</h3><p>{{ w.text }}</p></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <h2>{{ t.careers.openings_title }}</h2>
    <p class="notice">{{ t.careers.openings_empty }}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>{{ t.careers.apply_title }}</h2>
    <p class="lead">{{ t.careers.apply_text }}</p>
    <p class="big-link"><a href="mailto:{{ site.email_hr }}">{{ site.email_hr }}</a></p>
    <p class="small-note">{{ t.careers.privacy_note }}</p>
  </div>
</section>
