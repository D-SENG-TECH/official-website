{#- hero: scroll-driven cover (300vh track + sticky stage). Progress is computed in /assets/aimon/hero.js -#}
{%- set am_icons = [
  '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
  '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
  '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M9 15h6"/><path d="M12 18v-6"/>',
  '<path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14"/><path d="M16.5 9.4 7.55 4.24"/><path d="M3.29 7 12 12l8.71-5"/><path d="M12 22V12"/><circle cx="18.5" cy="15.5" r="2.5"/><path d="M20.27 17.27 22 19"/>',
  '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>'
] %}
<section class="am-hero" aria-label="{{ am.aria }}">
  <div class="am-hero-stage">
    <video class="am-hero-video" aria-hidden="true" autoplay loop muted playsinline preload="auto" poster="/assets/aimon/hero-bg-poster.jpg" tabindex="-1">
      <source src="/assets/aimon/hero-bg.webm" type="video/webm">
      <source src="/assets/aimon/hero-bg.mp4" type="video/mp4">
    </video>
    <div class="am-hero-shade" aria-hidden="true"></div>
    <div class="am-hero-glow" aria-hidden="true"></div>

    <div class="cc-container am-hero-top">
      <div class="cc-mono am-hero-top-label">{{ am.top }}</div>
    </div>

    <div class="cc-container am-hero-main">
      <div class="am-hero-col">
        <div class="am-hero-brand">
          <div class="am-hero-eyebrow-row">
            <div class="am-hero-eyebrow-bar"></div>
            <div class="cc-mono am-hero-eyebrow">{{ am.eyebrow }}</div>
          </div>
        </div>

        <h2 class="am-hero-h am-hero-h-top">
          <span class="am-hero-h-inner">{{ am.h1a }}<span class="am-hero-ul am-hero-ul-top" aria-hidden="true"></span></span>
        </h2>

        <div class="am-hero-gap">
          <ol class="am-hero-steps">
            <div class="am-hero-spine" aria-hidden="true"></div>
            {%- for s in am.steps %}
            <li class="am-hero-step">
              <div class="am-hero-node">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ am_icons[loop.index0] | safe }}</svg>
              </div>
              <div class="am-hero-step-text">
                <div class="am-hero-step-line">
                  <span class="cc-mono am-hero-step-n">{{ am.step }} {{ s.n }}</span>
                  <span class="am-hero-step-head">{{ s.head }}</span>
                </div>
                <div class="am-hero-step-body">{{ s.body }}</div>
              </div>
            </li>
            {%- endfor %}
          </ol>
        </div>

        <h2 class="am-hero-h">
          <span class="am-hero-h-inner">{{ am.h1b }}<span class="am-hero-ul am-hero-ul-bottom" aria-hidden="true"></span></span>
        </h2>

        <div class="am-hero-support">
          <div class="am-hero-sub">{{ am.sub }}</div>
          <p class="am-hero-desc">{{ am.desc }}</p>
        </div>
      </div>
    </div>

    <div class="cc-container am-hero-bottom">
      <div class="am-hero-bottom-row">
        <div class="cc-mono am-hero-bottom-label">{{ am.bottom }}</div>
        <button type="button" class="am-hero-cue" aria-label="{{ am.cue }}">
          {{ am.cue }}
          <svg class="am-hero-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>
<script src="/assets/aimon/hero.js" defer></script>
