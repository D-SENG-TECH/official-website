              <text x="49.8" y="55.8" fill="rgba(255,255,255,0.55)" font-family="monospace" font-size="9" text-anchor="middle">1×</text>
              <text x="69.5" y="81.1" fill="rgba(255,255,255,0.55)" font-family="monospace" font-size="9" text-anchor="middle">2×</text>
              <text x="101.2" y="32.9" fill="#f59e0b" font-family="monospace" font-size="9" text-anchor="middle">BPFO</text>
              <text x="266.8" y="76.5" fill="rgba(255,255,255,0.55)" font-family="monospace" font-size="9" text-anchor="middle">BPF</text>
              <text x="30.0" y="123" fill="rgba(255,255,255,0.4)" font-family="monospace" font-size="8" text-anchor="middle">0</text>
              <text x="110.0" y="123" fill="rgba(255,255,255,0.4)" font-family="monospace" font-size="8" text-anchor="middle">100</text>
              <text x="190.0" y="123" fill="rgba(255,255,255,0.4)" font-family="monospace" font-size="8" text-anchor="middle">200</text>
              <text x="270.0" y="123" fill="rgba(255,255,255,0.4)" font-family="monospace" font-size="8" text-anchor="middle">300</text>
              <text x="350.0" y="123" fill="rgba(255,255,255,0.4)" font-family="monospace" font-size="8" text-anchor="middle">400</text>
              <text x="30" y="140" fill="rgba(255,255,255,0.5)" font-family="monospace" font-size="9">{{ am.c3.today }}</text>
              <line x1="30" x2="350" y1="168" y2="168" stroke="rgba(255,255,255,0.18)" stroke-width="0.5" stroke-dasharray="3 3"></line>
              <polyline id="waveLine" points="30.0,164.9 31.3,154.0 32.7,159.5 34.0,167.4 35.3,166.5 36.7,161.0 38.0,158.7 39.3,160.5 40.7,162.1 42.0,161.2 43.3,159.6 44.7,159.2 46.0,159.7 47.3,160.0 48.7,159.7 50.0,159.3 51.3,159.3 52.7,159.6 54.0,159.7 55.3,159.7 56.7,159.8 58.0,160.0 59.3,160.2 60.7,160.4 62.0,160.6 63.3,160.8 64.7,161.0 66.0,161.2 67.3,161.5 68.7,161.7 70.0,161.9 71.3,162.1 72.7,162.3 74.0,162.5 75.3,156.4 76.7,153.6 78.0,162.9 79.3,168.4 80.7,165.3 82.0,160.9 83.3,161.1 84.7,163.8 86.0,164.8 87.3,163.7 88.7,162.7 90.0,163.0 91.3,163.7 92.7,163.9 94.0,163.5 95.3,163.3 96.7,163.5 98.0,163.7 99.3,163.7 100.7,163.7 102.0,163.7 103.3,163.9 104.7,164.1 106.0,164.2 107.3,164.4 108.7,164.6 110.0,164.9 111.3,165.2 112.7,165.5 114.0,165.9 115.3,166.3 116.7,166.7 118.0,167.2 119.3,167.7 120.7,158.5 122.0,162.7 123.3,172.6 124.7,174.8 126.0,170.6 127.3,168.4 128.7,170.7 130.0,173.7 131.3,174.3 132.7,173.6 134.0,173.8 135.3,175.0 136.7,176.2 138.0,176.7 139.3,176.9 140.7,177.4 142.0,178.1 143.3,178.7 144.7,179.1 146.0,179.4 147.3,179.8 148.7,180.1 150.0,180.4 151.3,180.5 152.7,180.6 154.0,180.7 155.3,180.7 156.7,180.6 158.0,180.5 159.3,180.3 160.7,180.0 162.0,179.7 163.3,179.3 164.7,175.4 166.0,168.3 167.3,175.8 168.7,182.3 170.0,179.7 171.3,174.1 172.7,172.6 174.0,174.4 175.3,175.1 176.7,173.4 178.0,171.3 179.3,170.6 180.7,170.5 182.0,169.9 183.3,168.8 184.7,167.7 186.0,167.0 187.3,166.4 188.7,165.7 190.0,164.9 191.3,164.2 192.7,163.6 194.0,163.0 195.3,162.5 196.7,161.9 198.0,161.4 199.3,161.0 200.7,160.7 202.0,160.4 203.3,160.1 204.7,159.9 206.0,159.7 207.3,159.6 208.7,159.5 210.0,151.1 211.3,151.7 212.7,161.3 214.0,164.9 215.3,160.7 216.7,157.2 218.0,158.3 219.3,161.1 220.7,161.7 222.0,160.6 223.3,160.0 224.7,160.7 226.0,161.6 227.3,161.8 228.7,161.6 230.0,161.7 231.3,162.0 232.7,162.4 234.0,162.5 235.3,162.6 236.7,162.7 238.0,162.9 239.3,163.1 240.7,163.1 242.0,163.2 243.3,163.3 244.7,163.3 246.0,163.4 247.3,163.4 248.7,163.4 250.0,163.5 251.3,163.5 252